{
  "name": "pulseboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @pulseboard/web",
    "start": "npm run start --workspace @pulseboard/web",
    "lint": "npm run lint --workspace @pulseboard/web",
    "typecheck": "npm run typecheck --workspace @pulseboard/web",
    "test": "npm run test --workspace @pulseboard/web",
    "build": "npm run build --workspace @pulseboard/web"
  }
}
